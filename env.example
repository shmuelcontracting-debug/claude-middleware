# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- GoHighLevel ---
# Private Integration token: GHL Settings -> Private Integrations -> Create
GHL_API_TOKEN=pit-xxxxxxxx
GHL_LOCATION_ID=your_ghl_location_id

# The GHL contact ID that represents YOU (the owner), so the "lead ready"
# WhatsApp message has somewhere to be sent. Easiest way to get this:
# create a contact for yourself in GHL with your WhatsApp number, then
# copy its contact ID from the URL when you open that contact.
OWNER_GHL_CONTACT_ID=contact_id_here
OWNER_PHONE_E164=+15551234567

# --- Server ---
PORT=3000
# Optional shared secret you also set as a custom header in GHL's webhook
# config, so random internet traffic can't hit your endpoint.
WEBHOOK_SHARED_SECRET=change-me

# --- Behavior toggles ---
# "true" = Claude sends replies to leads automatically
# "false" = Claude drafts a reply and logs it, but does not send (safer default)
AUTO_REPLY_LIVE=false
